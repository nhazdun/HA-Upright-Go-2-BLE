      "slouching_time": {
        "name": "Slouching time"
      },
      "upright_time": {
        "name": "Upright time"
      },
      "movement": {
        "name": "Movement",
        "state": {
          "idle": "Still",
          "moving": "Moving",
          "unknown": "Unknown"
        }
