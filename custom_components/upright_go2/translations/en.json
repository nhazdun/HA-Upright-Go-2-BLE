{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "description": "Add {name} ({address})?\n\nThe device must stay in range of a connectable Bluetooth adapter or ESPHome BLE proxy."
      },
      "user": {
        "data": {
          "address": "Device"
        },
        "description": "Pick the Upright GO 2 to add."
      }
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "no_devices_found": "No Upright GO 2 found. Wake the device by moving it, and make sure it is in range of a Bluetooth adapter or proxy.",
      "not_supported": "This device is not an Upright GO 2."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Polling interval",
          "history_interval": "History sync interval",
          "posture_debounce": "Posture debounce",
          "angle_delta": "Angle change to report"
        },
        "description": "Polling interval covers battery, settings and errors — posture and angle stream over BLE notifications instead. Posture debounce is how long a change must hold before it counts, which stops the device's chatter around the threshold from making the slouching sensor unusable in automations. Angle change to report keeps small wobbles out of the recorder; raise it if the database grows too fast, lower it for a smoother card. The connection is held open, so the phone app cannot connect while Home Assistant is attached."
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "slouching": {
        "name": "Slouching"
      }
    },
    "button": {
      "calibrate": {
        "name": "Calibrate"
      },
      "clear_calibration": {
        "name": "Clear calibration"
      },
      "deep_sleep": {
        "name": "Deep sleep"
      },
      "sync_history": {
        "name": "Sync history"
      },
      "clear_history": {
        "name": "Clear history"
      }
    },
    "number": {
      "delay": {
        "name": "Vibration delay"
      },
      "sensitivity": {
        "name": "Posture sensitivity"
      }
    },
    "select": {
      "vibration_pattern": {
        "name": "Vibration pattern",
        "state": {
          "long": "Long",
          "medium": "Medium",
          "short": "Short",
          "rumpup": "Ramp up",
          "knock": "Knock",
          "heartbeat": "Heartbeat",
          "tuk_tuk": "Tuk tuk",
          "ecstatic": "Ecstatic",
          "muzzle": "Muzzle"
        }
      },
      "vibration_strength": {
        "name": "Vibration strength",
        "state": {
          "gentle": "Gentle",
          "medium": "Medium",
          "strong": "Strong"
        }
      },
      "mode": {
        "name": "Mode",
        "state": {
          "posture": "Posture",
          "msk": "MSK"
        }
      }
    },
    "sensor": {
      "angle": {
        "name": "Posture angle"
      },
      "history_synced": {
        "name": "History last synced"
      },
      "slouching_time": {
        "name": "Slouching time"
      },
      "upright_time": {
        "name": "Upright time"
      },
      "movement": {
        "name": "Movement",
        "state": {
          "idle": "Still",
          "moving": "Moving",
          "unknown": "Unknown"
        }
      }
    },
    "switch": {
      "vibration": {
        "name": "Vibration"
      }
    }
  }
}
